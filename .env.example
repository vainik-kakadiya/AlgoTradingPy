# Copy to .env and fill in. Never commit .env.

# Local API binding (loopback by default; do not expose publicly without access controls)
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# SQLite database location (relative to AlgoTradingPy/)
DATABASE_URL=sqlite:///./data/algotrading.db

# Zerodha Kite Connect (market data only - this application never places real orders)
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
# Optional: a pre-generated access token. Usually obtained via the login flow in the dashboard.
KITE_ACCESS_TOKEN=

# Instrument master: underlyings whose derivatives are stored on refresh
INSTRUMENT_UNDERLYINGS=NIFTY,BANKNIFTY,FINNIFTY,SENSEX

# Start the Kite feed automatically on backend start when a valid token and active sessions exist
AUTO_START_FEED=true

# Persist raw ticks and 1-second bars captured from the live feed
CAPTURE_TICKS=true
CAPTURE_SECOND_BARS=true

LOG_LEVEL=INFO
