# Copy to .env and fill in. Never commit .env.

# Local API binding (loopback by default; do not expose publicly without access controls)
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# SQLite database location (relative to AlgoTradingPy/)
DATABASE_URL=sqlite:///./data/algotrading.db

# Zerodha Kite Connect (market data only - this application never places real orders)
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
# Optional: a pre-generated access token. Usually obtained via the login flow in the dashboard.
KITE_ACCESS_TOKEN=

# Instrument master: underlyings whose derivatives are stored on refresh
INSTRUMENT_UNDERLYINGS=NIFTY,BANKNIFTY,FINNIFTY,SENSEX

# Start the Kite feed automatically on backend start when a valid token and active sessions exist
AUTO_START_FEED=true

# Persist raw ticks and 1-second bars captured from the live feed
CAPTURE_TICKS=true
CAPTURE_SECOND_BARS=true

LOG_LEVEL=INFO

# Login for the web UI: the only account. REQUIRED - there is no default, and nobody can log in
# (and the Docker stack will not start) until both are set. Avoid "$" in the password.
# Changing the password logs out every existing session.
AUTH_EMAIL=you@example.com
AUTH_PASSWORD=
# Optional: how long a login lasts (hours, default 7 days)
# AUTH_SESSION_HOURS=168

# ---------------------------------------------------------------------------
# Docker deployment (AlgoTrading/docker-compose.yml runs backend + frontend together)
# ---------------------------------------------------------------------------
# The website port is set in AlgoTrading/.env (next to docker-compose.yml), not here:
#   HTTP_PORT=80
#   PUBLISH_HOST=0.0.0.0
#
# On a server, also set (replace <server> with the instance's IP or domain):
#   FRONTEND_URL=http://<server>        (Kite login redirects back here)
#   API_HOST=<server> and API_PORT=80   (only used to display the Kite redirect URL in Settings)
# and register http://<server>/api/kite/callback as the redirect URL in the Kite developer console.
