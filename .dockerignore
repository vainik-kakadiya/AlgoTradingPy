.git/
.gitignore
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.idea/
.vscode/

# Not needed at runtime
tests/
Dockerfile
docker-compose*.yml
.dockerignore
